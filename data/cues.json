[
 {
  "t0": 16.166,
  "t1": 25.63,
  "text": "窗外的天气 就像是你多变的表情"
 },
 {
  "t0": 26.334,
  "t1": 32.664,
  "text": "下雨了 雨陪我哭泣"
 },
 {
  "t0": 32.704,
  "t1": 38.251,
  "text": "看不清 我也不想看清"
 },
 {
  "t0": 38.291,
  "t1": 42.028,
  "text": "离开你 我安静的抽离"
 },
 {
  "t0": 42.068,
  "t1": 44.978,
  "text": "不忍揭晓的剧情"
 },
 {
  "t0": 45.018,
  "t1": 50.783,
  "text": "我的泪流在心里 学会放弃"
 },
 {
  "t0": 50.823,
  "t1": 53.949,
  "text": "听雨的声音 一滴滴清晰"
 },
 {
  "t0": 53.989,
  "t1": 59.242,
  "text": "你的呼吸像雨滴渗入我的爱里"
 },
 {
  "t0": 59.282,
  "t1": 63.05,
  "text": "真希望雨能下不停"
 },
 {
  "t0": 63.09,
  "t1": 69.013,
  "text": "让想念继续 让爱变透明"
 },
 {
  "t0": 69.053,
  "t1": 74.846,
  "text": "我爱上给我勇气的 Rainie Love"
 },
 {
  "t0": 74.886,
  "t1": 77.984,
  "text": "窗外的雨滴 一滴滴累积"
 },
 {
  "t0": 78.024,
  "t1": 83.323,
  "text": "屋内的湿气像储存爱你的记忆"
 },
 {
  "t0": 83.363,
  "t1": 86.983,
  "text": "真希望雨能下不停"
 },
 {
  "t0": 87.023,
  "t1": 92.993,
  "text": "雨爱的秘密 能一直延续"
 },
 {
  "t0": 93.033,
  "t1": 100.25,
  "text": "我相信我将会看到 彩虹的美丽"
 },
 {
  "t0": 124.202,
  "t1": 133.65,
